import numpy as np

def add_matrices(matrix1, matrix2):
    return matrix1 + matrix2

rows = int(input("Enter the number of rows: "))
cols = int(input("Enter the number of columns: "))

print("\nEnter elements for Matrix 1:")
list1 = []
for i in range(rows):
    row = []
    for j in range(cols):
        val = int(input(f"Enter element at position ({i},{j}): "))
        row.append(val)
    list1.append(row)
matrix1 = np.array(list1, dtype=int)

print("\nEnter elements for Matrix 2:")
list2 = []
for i in range(rows):
    row = []
    for j in range(cols):
        val = int(input(f"Enter element at position ({i},{j}): "))
        row.append(val)
    list2.append(row)
matrix2 = np.array(list2, dtype=int)

output_matrix = add_matrices(matrix1, matrix2)

print("\nThe resulting matrix after addition is:")
print(output_matrix)
