def is_right_angled(a, b, c):
    if a >= b and a >= c:
        hypotenuse = a
        side1, side2 = b, c
    elif b >= a and b >= c:
        hypotenuse = b
        side1, side2 = a, c
    else:
        hypotenuse = c
        side1, side2 = a, b
      
    if (side1 ** 2) + (side2 ** 2) == (hypotenuse ** 2):
        return True
    else:
        return False

side_a = int(input("Enter the length of the first side: "))
side_b = int(input("Enter the length of the second side: "))
side_c = int(input("Enter the length of the third side: "))

if is_right_angled(side_a, side_b, side_c):
    print("Yes, it is a right-angled triangle.")
else:
    print("No, it is not a right-angled triangle.")
